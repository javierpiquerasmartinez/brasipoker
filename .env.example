NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Supabase proporciona la clave pública como PUBLISHABLE_KEY (o ANON_KEY en proyectos anteriores). Cualquiera de las dos funciona:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-clave-publica-o-anonima
# NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publica-o-anonima
